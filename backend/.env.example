# Server & Network Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Crypto
AUTH_SECRET=your_random_32_character_secret_here

# Database Configuration (Optional; defaults to backend/data/sidequest.db)
# DATABASE_PATH=./data/sidequest.db

# Google Gemini API / Gemma 4 Inference
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# GitHub OAuth Integration (Optional: Phase 2 OAuth app credentials)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
